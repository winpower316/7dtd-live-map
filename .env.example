# 公開ホスト
PUBLIC_HOST=map.example.com
LETSENCRYPT_EMAIL=admin@example.com
PUBLIC_NETWORK_NAME=container_network

# 7 Days to Die Dedicated Serverの内蔵Web API
SEVEN_DAYS_HOST=gameserver.lan
SEVEN_DAYS_WEB_PORT=8080
PLAYER_API_TOKEN_NAME=map-player-reader
ACTIVITY_API_TOKEN_NAME=map-activity-reader

# Windowsエージェントからだけ到達できる待受アドレス
# 別PCから接続する場合はDockerホストのLAN IPを指定し、FWでも送信元を制限する。
AGENT_BIND_IP=127.0.0.1
AGENT_PORT=18081

# 危険操作なので既定は無効。READMEの注意事項を確認してからtrueにする。
RESTART_ENABLED=false

# 認証ゲートウェイ
AUTH_USERNAME=map
MAX_FAILURES=5
FAILURE_WINDOW_SECONDS=3600
BLOCK_SECONDS=86400
PBKDF2_ITERATIONS=600000
MAX_REQUEST_BODY_BYTES=262144
MAX_MAP_ENTITIES=500
MAX_PLAYER_PROFILES=100

# 履歴収集
ACTIVITY_LOG_COUNT=500
ACTIVITY_POLL_SECONDS=10
ACTIVITY_RETENTION_SECONDS=604800
ACTIVITY_MAX_EVENTS=2000
ACTIVITY_PUBLIC_LIMIT=200

# 再起動予約
RESTART_DELAY_SECONDS=300
RESTART_COOLDOWN_SECONDS=1800
RESTART_FAILURE_COOLDOWN_SECONDS=300

# ブラウザー表示・更新間隔
FRONTEND_MAP_NATIVE_MAX_ZOOM=4
FRONTEND_MAP_TILE_SIZE=128
FRONTEND_GAME_TIME_REFRESH_MS=10000
FRONTEND_PLAYER_REFRESH_MS=10000
FRONTEND_ACTIVITY_REFRESH_MS=10000
FRONTEND_MAP_ENTITY_REFRESH_MS=10000
FRONTEND_TRADER_EXPLORATION_REFRESH_MS=5000
FRONTEND_SERVER_VERSION_REFRESH_MS=60000
FRONTEND_APP_VERSION_REFRESH_MS=60000
FRONTEND_GAME_SCHEDULE_REFRESH_MS=60000
FRONTEND_RESTART_STATUS_REFRESH_MS=5000
FRONTEND_UNEXPLORED_TILE_MAX_BYTES=400
FRONTEND_TILE_RETRY_DELAYS_MS=0,250,750,1500
FRONTEND_CONFIG_RETRY_DELAYS_MS=0,300,900
FRONTEND_UNEXPLORED_TILE_REFRESH_MS=5000
FRONTEND_MOVING_PLAYER_MIN_SPEED_MPS=4
FRONTEND_MOVING_VEHICLE_MATCH_RADIUS=160
FRONTEND_MOVING_VEHICLE_RELEASE_MS=20000

# nginx
NGINX_WORKER_CONNECTIONS=1024
NGINX_KEEPALIVE_TIMEOUT_SECONDS=30
NGINX_TRUSTED_PROXY_CIDR=172.16.0.0/12
NGINX_UPSTREAM_KEEPALIVE=8
NGINX_MAP_CACHE_KEYS_ZONE_SIZE=16m
NGINX_MAP_CACHE_MAX_SIZE=2g
NGINX_MAP_CACHE_INACTIVE=7d
NGINX_MAP_TILE_CACHE_MAX_AGE_SECONDS=60
NGINX_MAP_TILE_STALE_SECONDS=240
NGINX_STATIC_CACHE_MAX_AGE_SECONDS=604800
NGINX_BIOME_CACHE_MAX_AGE_SECONDS=3600
NGINX_MAP_API_RATE=20r/s
NGINX_PLAYER_API_RATE=10r/s
NGINX_CONTROL_STATUS_RATE=10r/s
NGINX_CONTROL_ACTION_RATE=1r/s
NGINX_MAP_TILE_RATE=200r/s
NGINX_MAP_API_BURST=50
NGINX_PLAYER_API_BURST=30
NGINX_CONTROL_STATUS_BURST=30
NGINX_CONTROL_ACTION_BURST=5
NGINX_MAP_TILE_BURST=500
NGINX_PROXY_CONNECT_TIMEOUT_SECONDS=3
NGINX_MAP_API_READ_TIMEOUT_SECONDS=5
NGINX_PRIVATE_API_READ_TIMEOUT_SECONDS=7
NGINX_MAP_TILE_READ_TIMEOUT_SECONDS=10
NGINX_CONTROL_MAX_BODY_SIZE=4k
NGINX_MAP_CACHE_VALID_SECONDS=300
NGINX_MAP_CACHE_NOT_FOUND_SECONDS=30
NGINX_MAP_CACHE_LOCK_TIMEOUT_SECONDS=5
