# 公開ホスト
PUBLIC_HOST=map.example.com
LETSENCRYPT_EMAIL=admin@example.com
PUBLIC_NETWORK_NAME=container_network

# 7 Days to Die Dedicated Serverの内蔵Web API
SEVEN_DAYS_HOST=gameserver.lan
SEVEN_DAYS_WEB_PORT=8080
PLAYER_API_TOKEN_NAME=map-player-reader
ACTIVITY_API_TOKEN_NAME=map-activity-reader

# Windowsエージェントからだけ到達できる待受アドレス
# 別PCから接続する場合はDockerホストのLAN IPを指定し、FWでも送信元を制限する。
AGENT_BIND_IP=127.0.0.1
AGENT_PORT=18081

# 危険操作なので既定は無効。READMEの注意事項を確認してからtrueにする。
RESTART_ENABLED=false
